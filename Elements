Main:CreateButton("Click Me", function()  --name--
    print("Clicked!")
end)

Main:CreateToggle("Enable Fly", false, function(state) --name, current value--
    print("Fly:", state)
end)

Main:CreateSlider("Speed", 0, 200, 50, function(val)  --Name, current, max, min--
    print("Speed:", val)
end)

